{
  "name": "runtimeenglish",
  "type": "module",
  "version": "1.2.8",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug && mkdir -p ../apks && cp app/build/outputs/apk/debug/*.apk ../apks/",
    "android:apk:release": "npm run android:sync && cd android && ./gradlew assembleRelease && mkdir -p ../apks && cp app/build/outputs/apk/release/*.apk ../apks/",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "test:coverage": "vitest run --coverage",
    "captions:fetch": "node scripts/fetch-captions.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.6",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/geist-pixel": "^5.3.1",
    "@huggingface/transformers": "^3.8.1",
    "@lucide/astro": "^1.72.0",
    "@nanostores/preact": "^1.1.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "daisyui": "^5.8.0",
    "date-fns": "^4.4.0",
    "jspdf": "^4.2.1",
    "kokoro-js": "^1.2.1",
    "lucide-preact": "^1.72.0",
    "minisearch": "^7.2.0",
    "nanostores": "^1.5.5",
    "piper-tts-web": "^1.1.2",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "^2.6.7",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.10",
    "@vite-pwa/astro": "^2.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^21.0.4",
    "msw": "^2.15.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "youtube-transcript": "^1.3.1"
  }
}
