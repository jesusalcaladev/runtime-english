---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/geist-pixel";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Topbar from "../components/layout/Topbar.astro";
import SidebarNav from "../components/layout/SidebarNav";
import ToastHost from "../components/layout/ToastHost";
import {
  ALL_SESSIONS,
  TOTAL_EXERCISES,
  TOTAL_SESSIONS,
  getNavData,
} from "../data/curriculum";

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title = "RuntimeEnglish — Inglés técnico para developers",
  description = "Aprende inglés técnico de A1 a B2 con sesiones cortas, ejercicios reales y el slang de 2026.",
  fullWidth = false,
} = Astro.props;

const nav = getNavData();
const a1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "A1-A2").map(
  (entry) => entry.session.id,
);
const b1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "B1-B2").map(
  (entry) => entry.session.id,
);
---

<!doctype html>
<html lang="es" data-theme="runtimeenglish">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>

    <script is:inline>
      (function () {
        function applyStoredPreferences() {
          try {
            var raw = localStorage.getItem("runtimeenglish_v2");
            var theme = null;
            var parsed = null;
            if (raw) {
              parsed = JSON.parse(raw);
              theme = parsed && parsed.settings ? parsed.settings.theme : null;
            }
            if (!theme) {
              theme = window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
            }
            document.documentElement.dataset.theme =
              theme === "dark" ? "runtimeenglish-dark" : "runtimeenglish";
            var ttsEnabled =
              parsed && parsed.settings ? parsed.settings.ttsEnabled : true;
            document.documentElement.dataset.tts = ttsEnabled === false ? "off" : "on";
          } catch (error) {
            document.documentElement.dataset.theme = "runtimeenglish";
            document.documentElement.dataset.tts = "on";
          }
        }

        applyStoredPreferences();
        document.addEventListener("astro:after-swap", applyStoredPreferences);
        document.addEventListener("astro:page-load", applyStoredPreferences);
      })();
    </script>
  </head>

  <body class="min-h-screen bg-base-100 font-sans text-base-content">
    <Topbar
      a1SessionIds={a1SessionIds}
      b1SessionIds={b1SessionIds}
      totalSessions={TOTAL_SESSIONS}
      totalExercises={TOTAL_EXERCISES}
    />

    <div class="mx-auto flex w-full max-w-[1600px] flex-1 items-start">
      <SidebarNav client:only="preact" transition:persist modules={nav} />

      <main
        class:list={[
          "min-w-0 flex-1",
          fullWidth
            ? "pb-[env(safe-area-inset-bottom,0px)]"
            : "px-4 pt-6 pb-[calc(3.5rem+env(safe-area-inset-bottom,0px))] sm:px-6 sm:pt-8 lg:px-10 lg:pt-10",
        ]}
      >
        <slot />
      </main>
    </div>

    <ToastHost client:only="preact" transition:persist />

    <script is:inline>
      if ("serviceWorker" in navigator) {
        var isNativeApp =
          window.Capacitor &&
          typeof window.Capacitor.isNativePlatform === "function" &&
          window.Capacitor.isNativePlatform();
        if (isNativeApp) {
          // El APK sirve todo local; el SW puede devolver HTML cacheado obsoleto
          // y sus fallbacks al dashboard rompen la navegación en Capacitor.
          navigator.serviceWorker
            .getRegistrations()
            .then(function (registrations) {
              registrations.forEach(function (registration) {
                registration.unregister();
              });
            })
            .catch(function () {});
          if (window.caches && caches.keys) {
            caches
              .keys()
              .then(function (keys) {
                keys.forEach(function (key) {
                  if (key.indexOf("runtimeenglish") === 0 || key.indexOf("devlingo") === 0) {
                    caches.delete(key);
                  }
                });
              })
              .catch(function () {});
          }
        } else {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register("/sw.js").catch(function () {});
          });
        }
      }
    </script>

    <script>
      import { Capacitor } from "@capacitor/core";
      import { App } from "@capacitor/app";
      import { Browser } from "@capacitor/browser";
      import { syncStreakReminder } from "../lib/notifications";
      import { progressStore } from "../lib/progress";
      import { initVoices, speak } from "../lib/speech";
      import { supabase } from "../lib/supabase";

      initVoices();
      void syncStreakReminder(progressStore.getState().settings);
      try {
        progressStore.backfillPhrasebook();
      } catch (e) {
        console.warn("Dictionary backfill failed", e);
      }

      const nativeWindow = window as Window & {
        __runtimeenglishBackBound?: boolean;
        __runtimeenglishSpeechBound?: boolean;
        __runtimeenglishAuthBound?: boolean;
      };

      // Manejo del botón atrás en Android/Capacitor
      if (Capacitor.isNativePlatform() && !nativeWindow.__runtimeenglishBackBound) {
        nativeWindow.__runtimeenglishBackBound = true;
        App.addListener("backButton", ({ canGoBack }) => {
          if (canGoBack) {
            window.history.back();
          } else {
            App.exitApp();
          }
        });
      }

      // Retorno de OAuth nativo (Supabase PKCE) vía deep link
      if (Capacitor.isNativePlatform() && !nativeWindow.__runtimeenglishAuthBound) {
        nativeWindow.__runtimeenglishAuthBound = true;
        void App.addListener("appUrlOpen", async ({ url }) => {
          if (!url.startsWith("com.runtimeenglish.core://login-callback")) return;
          try {
            await Browser.close();
          } catch {}
          if (!supabase) return;
          try {
            const parsed = new URL(url);
            const errorDesc =
              parsed.searchParams.get("error_description") ||
              parsed.searchParams.get("error");
            if (errorDesc) {
              console.error("Supabase auth error:", errorDesc);
              return;
            }
            const code = parsed.searchParams.get("code");
            if (code) {
              const { error } = await supabase.auth.exchangeCodeForSession(code);
              if (error) console.error("exchangeCodeForSession:", error.message);
              return;
            }
            // Fallback: si el flujo devolviera tokens en el hash
            const hash = parsed.hash.startsWith("#") ? parsed.hash.slice(1) : parsed.hash;
            if (hash) {
              const params = new URLSearchParams(hash);
              const access_token = params.get("access_token");
              const refresh_token = params.get("refresh_token");
              if (access_token && refresh_token) {
                const { error } = await supabase.auth.setSession({
                  access_token,
                  refresh_token,
                });
                if (error) console.error("setSession:", error.message);
              }
            }
          } catch (e) {
            console.error("Native auth callback failed:", e);
          }
        });
      }

      // Delegación de TTS para botones con data-speak
      if (!nativeWindow.__runtimeenglishSpeechBound) {
        nativeWindow.__runtimeenglishSpeechBound = true;
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest("[data-speak]");
          if (!(button instanceof HTMLElement)) return;
          event.preventDefault();
          speak(button.dataset.speak ?? "", button);
        });
      }
    </script>
  </body>
</html>
