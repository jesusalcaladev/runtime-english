---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/geist-pixel";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Topbar from "../components/Topbar.astro";
import SidebarNav from "../components/SidebarNav";
import ToastHost from "../components/ToastHost";
import {
  ALL_SESSIONS,
  TOTAL_EXERCISES,
  TOTAL_SESSIONS,
  getNavData,
} from "../data/curriculum";

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
}

const {
  title = "DevEng // Core — Inglés técnico para developers",
  description = "Aprende inglés técnico de A1 a B2 con sesiones cortas, ejercicios reales y el slang de 2026.",
  fullWidth = false,
} = Astro.props;

const nav = getNavData();
const a1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "A1-A2").map(
  (entry) => entry.session.id,
);
const b1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "B1-B2").map(
  (entry) => entry.session.id,
);
---

<!doctype html>
<html lang="es" data-theme="deveng" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>

    <script is:inline>
      (function () {
        function applyStoredPreferences() {
          try {
            var raw = localStorage.getItem("deveng_core_v2");
            var theme = null;
            var parsed = null;
            if (raw) {
              parsed = JSON.parse(raw);
              theme = parsed && parsed.settings ? parsed.settings.theme : null;
            }
            if (!theme) {
              theme = window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
            }
            document.documentElement.dataset.theme =
              theme === "dark" ? "deveng-dark" : "deveng";
            var ttsEnabled =
              parsed && parsed.settings ? parsed.settings.ttsEnabled : true;
            document.documentElement.dataset.tts = ttsEnabled === false ? "off" : "on";
          } catch (error) {
            document.documentElement.dataset.theme = "deveng";
            document.documentElement.dataset.tts = "on";
          }
        }

        applyStoredPreferences();
        document.addEventListener("astro:after-swap", applyStoredPreferences);
      })();
    </script>
  </head>

  <body class="min-h-screen bg-base-100 font-sans text-base-content">
    <Topbar
      a1SessionIds={a1SessionIds}
      b1SessionIds={b1SessionIds}
      totalSessions={TOTAL_SESSIONS}
      totalExercises={TOTAL_EXERCISES}
    />

    <div class="mx-auto flex w-full max-w-[1600px] flex-1 items-start">
      <SidebarNav client:only="preact" transition:persist modules={nav} />

      <main
        class:list={[
          "min-w-0 flex-1",
          fullWidth
            ? "pb-[env(safe-area-inset-bottom,0px)]"
            : "px-4 pt-6 pb-[calc(3.5rem+env(safe-area-inset-bottom,0px))] sm:px-6 sm:pt-8 lg:px-10 lg:pt-10",
        ]}
      >
        <slot />
      </main>
    </div>

    <ToastHost client:only="preact" transition:persist />

    <script is:inline>
      (function () {
        var capacitor = window.Capacitor;
        if (!capacitor || !capacitor.isNativePlatform || !capacitor.isNativePlatform()) {
          return;
        }
        if (!document.startViewTransition) return;
        document.startViewTransition = function (callback) {
          var update = Promise.resolve().then(function () {
            return callback();
          });
          return {
            ready: Promise.resolve(),
            updateCallbackDone: update,
            finished: update,
            skipTransition: function () {},
          };
        };
      })();
    </script>

    <script>
      import { Capacitor } from "@capacitor/core";
      import { App } from "@capacitor/app";
      import { initVoices, speak } from "../lib/speech";

      initVoices();

      const nativeWindow = window as Window & {
        __devengBackBound?: boolean;
        __devengSpeechBound?: boolean;
      };
      if (Capacitor.isNativePlatform() && !nativeWindow.__devengBackBound) {
        nativeWindow.__devengBackBound = true;
        App.addListener("backButton", ({ canGoBack }) => {
          if (canGoBack) {
            window.history.back();
          } else {
            App.exitApp();
          }
        });
      }

      if (!nativeWindow.__devengSpeechBound) {
        nativeWindow.__devengSpeechBound = true;
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest("[data-speak]");
          if (!(button instanceof HTMLElement)) return;
          event.preventDefault();
          speak(button.dataset.speak ?? "", button);
        });
      }
    </script>
  </body>
</html>
