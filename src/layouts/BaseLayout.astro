---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/geist-pixel";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Topbar from "../components/layout/Topbar.astro";
import SidebarNav from "../components/layout/SidebarNav";
import ToastHost from "../components/layout/ToastHost";
import AppUpdateBanner from "../components/layout/AppUpdateBanner";
import {
  ALL_SESSIONS,
  TOTAL_EXERCISES,
  TOTAL_SESSIONS,
  getNavData,
} from "../data/curriculum";

interface Props {
  title?: string;
  description?: string;
  fullWidth?: boolean;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
}

const {
  title = "RuntimeEnglish — Inglés técnico para developers",
  description = "Aprende inglés técnico de A1 a B2 con sesiones cortas, ejercicios reales y el slang de 2026.",
  fullWidth = false,
  image = "/favicon.svg",
  noindex = false,
  type = "website",
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? (Astro.url ? `${Astro.url.protocol}//${Astro.url.host}` : "");
const canonicalUrl = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.toString();
const imageUrl = image.startsWith("http") ? image : (site ? new URL(image, site).toString() : image);
const siteName = "RuntimeEnglish";
const locale = "es_ES";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  description,
  url: canonicalUrl,
  inLanguage: "es",
  applicationCategory: "EducationalApplication",
};

const nav = getNavData();
const a1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "A1-A2").map(
  (entry) => entry.session.id,
);
const b1SessionIds = ALL_SESSIONS.filter((entry) => entry.module.level === "B1-B2").map(
  (entry) => entry.session.id,
);
---

<!doctype html>
<html lang="es" data-theme="runtimeenglish">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101010" />
    <meta name="color-scheme" content="light dark" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      (function () {
        function applyStoredPreferences() {
          try {
            var keys = ["runtimeenglish_v3","runtimeenglish_v2","devlingo_v3","devlingo_v2","deveng_core_v2"];
            var raw = null;
            var parsed = null;
            for (var i = 0; i < keys.length; i++) {
              raw = localStorage.getItem(keys[i]);
              if (!raw) continue;
              try { parsed = JSON.parse(raw); break; } catch (e) { parsed = null; }
            }
            var state = parsed && parsed.state && typeof parsed.state === "object" ? parsed.state : parsed;
            var settings = state && state.settings ? state.settings : null;
            var theme = settings ? settings.theme : null;
            if (theme !== "dark" && theme !== "light") {
              theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.dataset.theme = theme === "dark" ? "runtimeenglish-dark" : "runtimeenglish";
            var ttsEnabled = settings ? settings.ttsEnabled : true;
            document.documentElement.dataset.tts = ttsEnabled === false ? "off" : "on";
          } catch (error) {
            document.documentElement.dataset.theme = "runtimeenglish";
            document.documentElement.dataset.tts = "on";
          }
        }

        applyStoredPreferences();
        document.addEventListener("astro:after-swap", applyStoredPreferences);
        document.addEventListener("astro:page-load", applyStoredPreferences);
      })();
    </script>
  </head>

  <body class="min-h-screen bg-base-100 font-sans text-base-content">
    <Topbar
      a1SessionIds={a1SessionIds}
      b1SessionIds={b1SessionIds}
      totalSessions={TOTAL_SESSIONS}
      totalExercises={TOTAL_EXERCISES}
    />

    <div class="mx-auto flex w-full max-w-[1600px] flex-1 items-start">
      <SidebarNav client:only="preact" transition:persist modules={nav} />

      <main
        class:list={[
          "min-w-0 flex-1",
          fullWidth
            ? "pb-[env(safe-area-inset-bottom,0px)]"
            : "px-4 pt-6 pb-[calc(3.5rem+env(safe-area-inset-bottom,0px))] sm:px-6 sm:pt-8 lg:px-10 lg:pt-10",
        ]}
      >
        <slot />
      </main>
    </div>

    <ToastHost client:only="preact" transition:persist />
    <AppUpdateBanner client:only="preact" transition:persist />

    <script is:inline define:vars={{ isDev: import.meta.env.DEV }}>
      if ("serviceWorker" in navigator) {
        var isNativeApp =
          window.Capacitor &&
          typeof window.Capacitor.isNativePlatform === "function" &&
          window.Capacitor.isNativePlatform();
        if (isNativeApp || isDev) {
          // En nativo el APK sirve contenido local; en desarrollo el SW/PWA cachea versiones
          // viejas y dificulta iterar. Desregistrar SWs y limpiar caches relacionadas.
          navigator.serviceWorker
            .getRegistrations()
            .then(function (registrations) {
              registrations.forEach(function (registration) {
                registration.unregister();
              });
            })
            .catch(function () {});
          if (window.caches && caches.keys) {
            caches
              .keys()
              .then(function (keys) {
                keys.forEach(function (key) {
                  if (key.indexOf("runtimeenglish") === 0 || key.indexOf("devlingo") === 0 || key.indexOf("workbox") !== -1 || key.indexOf("vite") !== -1) {
                    caches.delete(key);
                  }
                });
              })
              .catch(function () {});
          }
        } else {
          window.addEventListener("load", function () {
            navigator.serviceWorker.register("/sw.js").catch(function () {});
          });
        }
      }
    </script>

    <script>
      import { Capacitor } from "@capacitor/core";
      import { App } from "@capacitor/app";
      import { Browser } from "@capacitor/browser";
      import { syncStreakReminder } from "../lib/notifications";
      import { progressStore } from "../lib/progress";
      import { initVoices, speak, warmSpeechEngine } from "../lib/speech";
      import { supabase } from "../lib/supabase";

      initVoices();
      void syncStreakReminder(progressStore.getState().settings);
      try {
        progressStore.backfillPhrasebook();
      } catch (e) {
        console.warn("Dictionary backfill failed", e);
      }

      const nativeWindow = window as Window & {
        __runtimeenglishBackBound?: boolean;
        __runtimeenglishSpeechBound?: boolean;
        __runtimeenglishAuthBound?: boolean;
      };

      // Manejo del botón atrás en Android/Capacitor
      if (Capacitor.isNativePlatform() && !nativeWindow.__runtimeenglishBackBound) {
        nativeWindow.__runtimeenglishBackBound = true;
        App.addListener("backButton", ({ canGoBack }) => {
          if (canGoBack) {
            window.history.back();
          } else {
            App.exitApp();
          }
        });
      }

      // Retorno de OAuth nativo (Supabase PKCE) vía deep link
      if (Capacitor.isNativePlatform() && !nativeWindow.__runtimeenglishAuthBound) {
        nativeWindow.__runtimeenglishAuthBound = true;
        void App.addListener("appUrlOpen", async ({ url }) => {
          if (!url.startsWith("com.runtimeenglish.core://login-callback")) return;
          try {
            await Browser.close();
          } catch {}
          if (!supabase) return;
          try {
            const parsed = new URL(url);
            const errorDesc =
              parsed.searchParams.get("error_description") ||
              parsed.searchParams.get("error");
            if (errorDesc) {
              console.error("Supabase auth error:", errorDesc);
              return;
            }
            const code = parsed.searchParams.get("code");
            if (code) {
              const { error } = await supabase.auth.exchangeCodeForSession(code);
              if (error) console.error("exchangeCodeForSession:", error.message);
              return;
            }
            // Fallback: si el flujo devolviera tokens en el hash
            const hash = parsed.hash.startsWith("#") ? parsed.hash.slice(1) : parsed.hash;
            if (hash) {
              const params = new URLSearchParams(hash);
              const access_token = params.get("access_token");
              const refresh_token = params.get("refresh_token");
              if (access_token && refresh_token) {
                const { error } = await supabase.auth.setSession({
                  access_token,
                  refresh_token,
                });
                if (error) console.error("setSession:", error.message);
              }
            }
          } catch (e) {
            console.error("Native auth callback failed:", e);
          }
        });
      }

      // Delegación de TTS para botones con data-speak
      if (!nativeWindow.__runtimeenglishSpeechBound) {
        nativeWindow.__runtimeenglishSpeechBound = true;
        const warmOnIntent = (event: Event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest("[data-speak]");
          if (!(button instanceof HTMLElement)) return;
          try { warmSpeechEngine(); } catch {}
        };
        document.addEventListener("pointerdown", warmOnIntent, { passive: true });
        document.addEventListener("focusin", warmOnIntent);
        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest("[data-speak]");
          if (!(button instanceof HTMLElement)) return;
          event.preventDefault();
          speak(button.dataset.speak ?? "", button);
        });
      }
    </script>
  </body>
</html>
