---
import Dashboard from '../components/dashboard/Dashboard'
import { getAllExerciseIds, getNavData, TOTAL_EXERCISES } from '../data/curriculum'
import BaseLayout from '../layouts/BaseLayout.astro'
import { ACHIEVEMENTS } from '../lib/achievements'

const modules = getNavData()
const exerciseIds = getAllExerciseIds()
---

<BaseLayout>
  <div class="relative">
    <div
      id="dashboard-skeleton"
      aria-hidden="true"
      class="animate-pulse bg-base-100"
    >
      <div class="app-container space-y-3 pb-2">
        <div class="h-40 rounded-[28px] bg-base-200 sm:h-52"></div>
        <div class="h-56 rounded-[28px] bg-base-200"></div>
      </div>
    </div>

    <Dashboard
      client:only="preact"
      modules={modules}
      totalExercises={TOTAL_EXERCISES}
      totalAchievements={ACHIEVEMENTS.length}
      exerciseIds={exerciseIds}
    />
  </div>

  <footer class="mx-auto mt-16 max-w-[1120px]">
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-base-200/60 px-4 py-3">
      <p class="font-pixel-square text-[12px] tracking-wide text-base-content/50">
        RuntimeEnglish
      </p>
      <p class="text-[10px] text-base-content/30">
        Inglés técnico para developers · progreso local en tu navegador
      </p>
    </div>
  </footer>
</BaseLayout>

<script>
  const skeletonWindow = window as Window & { __runtimeenglishDashboardSkeletonBound?: boolean }
  if (!skeletonWindow.__runtimeenglishDashboardSkeletonBound) {
    skeletonWindow.__runtimeenglishDashboardSkeletonBound = true
    const removeSkeleton = () => document.getElementById('dashboard-skeleton')?.remove()
    document.addEventListener('runtimeenglish:dashboard-ready', removeSkeleton)
    // Red de seguridad: si la isla no llega a montarse (JS lento o navegación
    // con ClientRouter), el overlay no debe quedarse parpadeando para siempre.
    window.setTimeout(removeSkeleton, 3000)
  }
</script>
