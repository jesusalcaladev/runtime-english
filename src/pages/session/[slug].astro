---
import { ArrowDown, ArrowLeft, ArrowRight, Clock, Target } from '@lucide/astro'
import ExerciseRunner from '../../components/exercise/ExerciseRunner'
import LessonBlocks from '../../components/session/LessonBlocks.astro'
import LevelProgressCard from '../../components/session/LevelProgressCard'
import SessionProgressCard from '../../components/session/SessionProgressCard'
import SessionSpeechPrewarm from '../../components/session/SessionSpeechPrewarm'
import Badge from '../../components/ui/Badge.astro'
import PageHeader from '../../components/ui/PageHeader.astro'
import SpeakButton from '../../components/ui/SpeakButton.astro'
import { ALL_SESSIONS, getAdjacentSession, type SessionWithModule } from '../../data/curriculum'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { route } from '../../lib/routes'
import { getSessionMinutes } from '../../lib/sessionTime'
import { collectSessionSpeechTexts } from '../../lib/speech/sessionPhrases'
import type { Module, Session } from '../../lib/types'

interface Props {
  session: Session
  module: Module
  previous?: SessionWithModule
  next?: SessionWithModule
}

export function getStaticPaths() {
  return ALL_SESSIONS.map(({ session, module }) => {
    const { previous, next } = getAdjacentSession(session.id)
    return {
      params: { slug: session.slug },
      props: { session, module, previous, next },
    }
  })
}

const { session, module, previous, next } = Astro.props as Props
const nextForRunner = next
  ? { slug: next.session.slug, title: next.session.title, step: next.session.step }
  : null
const levelSessions = ALL_SESSIONS.filter((entry) => entry.module.level === module.level)
const levelIndex = levelSessions.findIndex((entry) => entry.session.id === session.id) + 1
const exerciseIds = session.exercises.map((exercise) => exercise.id)
const speechTexts = collectSessionSpeechTexts(
  session.blocks,
  session.exercises,
  session.pronunciation,
)
---

<BaseLayout title={`${session.title} · RuntimeEnglish`} description={session.summary}>
  <SessionSpeechPrewarm texts={speechTexts} client:only="preact" />
  <article class="app-container animate-fade-up">
    <nav
      class="flex flex-wrap items-center gap-2 text-[10px] text-base-content/35"
      aria-label="Breadcrumb"
    >
      <a href={route(`/?level=${module.level}`)} class="transition hover:text-base-content/65">
        {module.level}
      </a>
      <span class="text-base-content/20">/</span>
      <span>{module.shortTitle}</span>
      <span class="text-base-content/20">/</span>
      <span class="font-mono text-base-content/50">
        {module.level} · {levelIndex} de {levelSessions.length}
      </span>
    </nav>

    <PageHeader
      eyebrow={`${module.level} · ${module.code}`}
      title={session.title}
      description={session.summary}
      class="mt-5"
    >
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <Badge tone="primary"><span class="font-mono">{module.level}</span></Badge>
        <Badge tone="accent"><span class="font-mono">{session.cefr}</span></Badge>
        <span class="flex items-center gap-1.5 text-[10px] text-base-content/45">
          <Clock class="h-3 w-3" />
          {getSessionMinutes(session)} min
        </span>
        <span class="text-[10px] text-base-content/45">
          {session.exercises.length} ejercicios
        </span>
      </div>
    </PageHeader>

    <div class="mt-9 grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-start">
      <div class="min-w-0">
        <LessonBlocks blocks={session.blocks} />
      </div>

      <aside class="hidden space-y-3 lg:block lg:sticky lg:top-20">
        <SessionProgressCard
          client:only="preact"
          sessionId={session.id}
          exerciseIds={exerciseIds}
        />

        <div class="surface-muted mt-4 bg-base-200 p-4">
          <p class="mono-label flex items-center gap-1.5">
            <Target class="h-3 w-3 text-accent" />
            Detalles de la sesión
          </p>
          <p class="mt-2 text-[10px] font-medium text-base-content/40">Al terminar</p>
          <ul class="mt-2.5 space-y-2">
            {session.objectives.map((objective) => (
              <li class="flex items-start gap-2 text-[11px] leading-relaxed text-base-content/50">
                <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent/60" />
                {objective}
              </li>
            ))}
          </ul>

          {session.pronunciation && (
            <div class="mt-3 border-t border-base-content/10 pt-3">
              <div class="flex items-center justify-between gap-2">
                <p class="mono-label text-accent/75">Pronunciación</p>
                <SpeakButton text={session.pronunciation} />
              </div>
              <p class="mt-2 text-[13px] leading-6 text-base-content/65">
                “{session.pronunciation}”
              </p>
              <p class="mt-1 text-[10px] text-base-content/35">
                Escúchala, repítela y úsala en tu próximo standup.
              </p>
            </div>
          )}
        </div>

        <LevelProgressCard
          client:only="preact"
          level={module.level}
          currentSessionId={session.id}
        />
      </aside>
    </div>

    <div class="sticky bottom-3 z-20 mt-6 lg:hidden">
      <a
        href="#practica"
        class="btn btn-primary h-12 w-full gap-2 rounded-2xl text-[13px] shadow-lg"
      >
        <ArrowDown class="h-4 w-4" />
        {session.exercises.length} ejercicios · Practicar
      </a>
    </div>

    <section id="practica" class="mt-8 max-w-3xl scroll-mt-20">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mono-label">Ponlo a prueba</p>
          <h2 class="font-pixel mt-2 text-[1.85rem] leading-tight tracking-tight">
            Ejercicios de la sesión
          </h2>
          <p class="mt-2 max-w-xl text-xs leading-relaxed text-base-content/40">
            Cada acierto suma XP y guarda las frases correctas en tu diccionario para repasar con
            flashcards. La sesión se completa al resolverlos todos.
          </p>
        </div>
      </div>

      <ExerciseRunner
        client:only="preact"
        sessionId={session.id}
        sessionTitle={session.title}
        exercises={session.exercises}
        next={nextForRunner}
        level={module.level}
      />
    </section>

    <nav class="mt-10 flex max-w-3xl items-center justify-between gap-2">
      {previous ? (
        <a
          href={route(`/session/${previous.session.slug}`)}
          class="group flex min-w-0 items-center gap-2.5 rounded-2xl bg-base-200 px-3 py-2.5 text-xs text-base-content/50 transition hover:bg-base-300/60 hover:text-base-content/75"
        >
          <ArrowLeft class="h-3.5 w-3.5 shrink-0" />
          <span class="min-w-0">
            <span class="block text-[9px] tracking-normal text-base-content/25">
              Anterior
            </span>
            <span class="block max-w-[180px] truncate sm:max-w-[280px]">
              {previous.session.title}
            </span>
          </span>
        </a>
      ) : (
        <a
          href={route("/")}
          class="flex items-center gap-1.5 rounded-2xl bg-base-200 px-3 py-2.5 text-xs text-base-content/50 transition hover:bg-base-300/60 hover:text-base-content/75"
        >
          <ArrowLeft class="h-3.5 w-3.5" /> Roadmap
        </a>
      )}

      {next ? (
        <a
          href={route(`/session/${next.session.slug}`)}
          class="group flex min-w-0 items-center gap-2.5 rounded-2xl bg-base-200 px-3 py-2.5 text-right text-xs text-base-content/50 transition hover:bg-base-300/60 hover:text-base-content/75"
        >
          <span class="min-w-0">
            <span class="block text-[9px] tracking-normal text-base-content/25">
              Siguiente
            </span>
            <span class="block max-w-[180px] truncate sm:max-w-[280px]">
              {next.session.title}
            </span>
          </span>
          <ArrowRight class="h-3.5 w-3.5 shrink-0" />
        </a>
      ) : (
        <a
          href={route("/")}
          class="flex items-center gap-1.5 rounded-2xl bg-base-200 px-3 py-2.5 text-xs text-base-content/50 transition hover:bg-base-300/60 hover:text-base-content/75"
        >
          Volver al roadmap <ArrowRight class="h-3.5 w-3.5" />
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
