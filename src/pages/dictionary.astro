---
import DictionaryView from '../components/dictionary/DictionaryView'
import PageHeader from '../components/ui/PageHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Diccionario · RuntimeEnglish"
  description="Tu diccionario personal de frases y vocabulario en inglés, con significados y progreso."
>
  <div class="page-shell animate-fade-up space-y-6">
    <PageHeader
      eyebrow="Tu aprendizaje"
      title="Diccionario"
      description="Tus frases guardadas. Repasa, escucha y edita."
    />

    <DictionaryView client:only="preact" />
  </div>
</BaseLayout>
