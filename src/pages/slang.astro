---
import { TriangleAlert } from '@lucide/astro'
import SlangExplorer from '../components/slang/SlangExplorer'
import PageHeader from '../components/ui/PageHeader.astro'
import { ALL_SESSIONS } from '../data/curriculum'
import { SLANG } from '../data/slang'
import BaseLayout from '../layouts/BaseLayout.astro'
import { route } from '../lib/routes'
import { getSessionMinutes } from '../lib/sessionTime'

const slangSessions = ALL_SESSIONS.filter((entry) => entry.module.id === 'm7').map(
  (entry) => entry.session,
)
---

<BaseLayout
  title="Slang 2026 para developers · RuntimeEnglish"
  description="El slang técnico y de internet más reciente: vibe coding, AI slop, workslop, meat proxy, cooked, aura farming y más."
>
  <div class="page-shell animate-fade-up space-y-8">
    <PageHeader
      eyebrow="Slang"
      title="El inglés que no aparece en los libros"
      description="Jerga de IA, equipo y 2026. Entiéndela antes de usarla; solo cuando el contexto lo permita."
    />

    {slangSessions.length > 0 && (
      <section class="space-y-3">
        <h2 class="text-[15px] font-semibold tracking-tight text-base-content/90">
          Práctica con slang
        </h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {slangSessions.map((session) => (
            <a
              href={route(`/session/${session.slug}`)}
              class="group rounded-2xl bg-base-200 p-4 transition hover:bg-base-300/70"
            >
              <div class="flex items-center justify-between gap-2">
                <span class="font-mono text-[10px] text-base-content/55">{session.step}</span>
                <span class="rounded-full bg-base-100/70 px-2 py-0.5 font-mono text-[10px] text-base-content/55">
                  {session.cefr}
                </span>
              </div>
              <h3 class="mt-2.5 text-[15px] font-medium leading-snug text-base-content">
                {session.title}
              </h3>
              <p class="mt-1.5 text-[13px] leading-relaxed text-base-content/65">{session.summary}</p>
              <p class="mt-3 text-[11px] text-base-content/50">
                {getSessionMinutes(session)} min · {session.exercises.length} ejercicios
              </p>
            </a>
          ))}
        </div>
      </section>
    )}

    <SlangExplorer client:only="preact" entries={SLANG} />

    <section class="flex gap-3 rounded-2xl bg-warning/[0.06] p-4">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-warning/10 text-warning">
        <TriangleAlert class="h-3.5 w-3.5" />
      </span>
      <p class="max-w-3xl text-[11px] leading-relaxed text-base-content/55">
        <span class="font-medium text-base-content/75">Cómo usar el deck.</span> “Consolidado” se entiende
        en cualquier equipo; “en alza” está entrando; “2026” es jerga nueva. Lo marcado como meme no va en
        una daily formal ni con clientes.
      </p>
    </section>
  </div>
</BaseLayout>
