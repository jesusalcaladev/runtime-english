---
import CertificateView from '../components/certificate/CertificateView'
import PageHeader from '../components/ui/PageHeader.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Certificate · RuntimeEnglish"
  description="Print your level certificate (A1-A2, B1-B2, C1-C2) from RuntimeEnglish."
  fullWidth={false}
>
  <div class="app-container animate-fade-up space-y-6 print:max-w-none">
    <div class="print:hidden">
      <PageHeader
        eyebrow="Completion / Certificate"
        title="English for Programmers"
        description="Completa las sesiones de un nivel para desbloquear su certificado imprimible en inglés con tu nombre."
      />
    </div>

    <CertificateView client:only="preact" />
  </div>
</BaseLayout>
