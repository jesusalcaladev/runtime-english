---
import { BookOpen, Headphones, Repeat2, Sparkles, Volume2 } from '@lucide/astro'
import ResourceExplorer from '../components/learn/ResourceExplorer'
import VideoLibrary from '../components/learn/VideoLibrary'
import PageHeader from '../components/ui/PageHeader.astro'
import { LEARNING_RESOURCES, VIDEO_LESSONS } from '../data/learningResources'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Aprende por tu cuenta · RuntimeEnglish"
  description="Videos con subtítulos en inglés resaltados, ejercicios de shadowing y los mejores recursos para aprender inglés por tu cuenta."
>
  <div class="mx-auto max-w-[1120px] animate-fade-up space-y-8">
    <PageHeader
      eyebrow="Aprende por tu cuenta · VideoLab"
      title="Aprende inglés rápido, con videos reales"
      description="Mira un video corto, sigue los subtítulos en inglés resaltados, repite en voz alta y guarda las frases útiles. Después, practica con los ejercicios de shadowing y emparejamiento."
    >
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="flex items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1.5 text-[10px] font-medium text-accent">
          <Sparkles class="h-3 w-3" />
          {VIDEO_LESSONS.length} videos con transcripción
        </span>
        <span class="rounded-full bg-base-200 px-3 py-1.5 text-[10px] text-base-content/50">
          {LEARNING_RESOURCES.length} recursos curados
        </span>
      </div>
    </PageHeader>

    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-2xl bg-base-200 p-4">
        <Headphones class="h-4 w-4 text-accent" />
        <p class="mt-3 text-[13px] font-medium text-base-content/85">1 · Escucha</p>
        <p class="mt-1 text-[12px] leading-relaxed text-base-content/50">
          Ve el video con los subtítulos en inglés. No traduzcas todavía.
        </p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <Volume2 class="h-4 w-4 text-accent" />
        <p class="mt-3 text-[13px] font-medium text-base-content/85">2 · Repite</p>
        <p class="mt-1 text-[12px] leading-relaxed text-base-content/50">
          Toca Escuchar y repite la frase en voz alta, con el mismo ritmo.
        </p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <BookOpen class="h-4 w-4 text-accent" />
        <p class="mt-3 text-[13px] font-medium text-base-content/85">3 · Guarda</p>
        <p class="mt-1 text-[12px] leading-relaxed text-base-content/50">
          Guarda 3 frases en tu diccionario y repásalas con flashcards.
        </p>
      </div>
      <div class="rounded-2xl bg-base-200 p-4">
        <Repeat2 class="h-4 w-4 text-accent" />
        <p class="mt-3 text-[13px] font-medium text-base-content/85">4 · Practica</p>
        <p class="mt-1 text-[12px] leading-relaxed text-base-content/50">
          Usa Repetir línea y haz los ejercicios de shadowing en las sesiones.
        </p>
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <p class="mono-label text-base-content/45">VideoLab</p>
        <h2 class="mt-1 text-[19px] font-semibold tracking-tight text-base-content/90">
          Videos con subtítulos resaltados
        </h2>
      </div>
      <VideoLibrary lessons={VIDEO_LESSONS} client:load />
    </section>

    <section class="space-y-4">
      <div>
        <p class="mono-label text-base-content/45">Recursos</p>
        <h2 class="mt-1 text-[19px] font-semibold tracking-tight text-base-content/90">
          Los mejores sitios y canales para practicar por tu cuenta
        </h2>
        <p class="mt-1 text-[12px] text-base-content/45">
          Todos los enlaces son externos y se abren en una pestaña nueva.
        </p>
      </div>

      <ResourceExplorer resources={LEARNING_RESOURCES} client:load />
    </section>
  </div>
</BaseLayout>
