---
import MicroPostCard from '../components/learn/MicroPostCard'
import PracticePackView from '../components/learn/PracticePack'
import ResourceExplorer from '../components/learn/ResourceExplorer'
import VideoLibrary from '../components/learn/VideoLibrary'
import PageHeader from '../components/ui/PageHeader.astro'
import { LEARNING_RESOURCES, VIDEO_LESSONS } from '../data/learningResources'
import { MICRO_POSTS } from '../data/posts'
import { PRACTICE_PACKS } from '../data/practices'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Aprende por tu cuenta · RuntimeEnglish"
  description="Videos con subtítulos en inglés resaltados, ejercicios de shadowing, prácticas extra, posts cortos y los mejores recursos para aprender inglés por tu cuenta."
>
  <div class="page-shell--wide animate-fade-up space-y-10">
    <PageHeader
      eyebrow="Aprende por tu cuenta"
      title="Aprende inglés por tu cuenta"
      description="Videos reales con subtítulos, prácticas extra, posts cortos y recursos. Todo suma al mismo progreso."
    />

    <section class="space-y-4">
      <h2 class="text-[15px] font-semibold tracking-tight text-base-content/90">Videos</h2>
      <VideoLibrary lessons={VIDEO_LESSONS} client:load />
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-[15px] font-semibold tracking-tight text-base-content/90">Prácticas extra</h2>
        <p class="mt-1 text-[12px] text-base-content/45">
          Ejercicios cortos para afianzar; cuentan para tu progreso y repaso.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {PRACTICE_PACKS.map((pack) => (
          <PracticePackView pack={pack} client:only="preact" />
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-[15px] font-semibold tracking-tight text-base-content/90">Posts</h2>
        <p class="mt-1 text-[12px] text-base-content/45">
          Tips cortos estilo X. Escucha, guarda la frase y practica.
        </p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {MICRO_POSTS.map((post) => (
          <MicroPostCard post={post} client:only="preact" />
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-[15px] font-semibold tracking-tight text-base-content/90">Recursos</h2>
        <p class="mt-1 text-[12px] text-base-content/45">
          Sitios y canales externos. Se abren en otra pestaña.
        </p>
      </div>
      <ResourceExplorer resources={LEARNING_RESOURCES} client:load />
    </section>
  </div>
</BaseLayout>
