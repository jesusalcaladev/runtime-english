---
import {
  CircleCheckBig,
  Info,
  Languages,
  Lightbulb,
  Table2,
  Terminal,
  TriangleAlert,
} from '@lucide/astro'
import { getSlang } from '../../data/slang'
import type { ContentBlock } from '../../lib/types'
import SpeakButton from '../ui/SpeakButton.astro'
import DialogueScene from './DialogueScene'
import SavePhraseButton from './SavePhraseButton'

interface Props {
  blocks: ContentBlock[]
}

const { blocks } = Astro.props
---

<div class="mb-2 flex flex-wrap items-center gap-2 rounded-2xl bg-accent/[0.06] px-4 py-3 text-[12px] leading-relaxed text-base-content/65 ring-1 ring-accent/10">
  <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-accent/12 text-accent"><Lightbulb class="h-3.5 w-3.5" /></span>
  <span><span class="font-medium text-base-content/80">Inglés accionable:</span> usa <span class="font-medium">Escuchar</span> y <span class="font-medium">Guardar</span> en frases y vocabulario. Al acertar ejercicios, las frases se guardan/actualizan automáticamente en tu diccionario.</span>
</div>

<div class="space-y-8">
  {
    blocks.map((block) => (
      <section>
        {block.type === "dialogue" && (
          <DialogueScene
            client:only="preact"
            title={block.title}
            setting={block.setting}
            goal={block.goal}
            context={block.context}
            lines={block.lines}
          />
        )}

        {block.type === "technique" && (
          <div class="relative overflow-hidden rounded-3xl bg-accent/[0.06] p-5 sm:p-6">
            <div class="pointer-events-none absolute -right-10 -top-12 h-32 w-32 rounded-full bg-accent/[0.08] blur-2xl" />
            <div class="relative flex gap-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15 text-accent">
                <Lightbulb class="h-5 w-5" />
              </span>
              <div class="space-y-2">
                <p class="mono-label text-accent/85">Técnica clave</p>
                <h3 class="text-[17px] font-semibold tracking-tight text-base-content/90">{block.name}</h3>
                <p class="max-w-3xl text-[15px] leading-7 text-base-content/75">{block.desc}</p>
              </div>
            </div>
          </div>
        )}

        {block.type === "text" && (
          <div class="space-y-2.5">
            {block.title && <h3 class="text-[17px] font-semibold tracking-tight text-base-content/90">{block.title}</h3>}
            <p class="max-w-3xl text-[15px] leading-7 text-base-content/75">{block.body}</p>
          </div>
        )}

        {block.type === "vocab" && (
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <Languages class="h-4 w-4 text-accent" />
              <h3 class="text-[17px] font-semibold tracking-tight text-base-content/90">
                {block.title ?? "Vocabulario"}
              </h3>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              {block.items.map((item) => (
                <div class="group rounded-2xl bg-base-200 p-4 sm:p-5 transition hover:bg-base-300/60">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                      <div class="inline-flex max-w-full items-center rounded-lg bg-accent/[0.08] px-2.5 py-1.5 ring-1 ring-accent/15">
                        <p class="font-mono text-[15px] font-semibold tracking-tight text-base-content">{item.en}</p>
                      </div>
                      <p class="mt-2 text-[13px] leading-relaxed text-base-content/70">
                        <span class="font-medium text-base-content/45">ES: </span>{item.es}
                      </p>
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                      <SavePhraseButton
                        client:load
                        en={item.en}
                        es={item.example ? `${item.es} · Ejemplo: ${item.example}` : item.es}
                        source="Vocabulario"
                      />
                      <SpeakButton text={item.example ?? item.en} />
                    </div>
                  </div>
                  {item.example && (
                    <div class="mt-3.5 rounded-xl bg-base-100/80 px-3.5 py-3">
                      <p class="mono-label mb-1 text-accent/70">Ejemplo</p>
                      <p class="font-mono text-[14px] leading-relaxed text-base-content/90">{item.example}</p>
                      {item.note && (
                        <p class="mt-1.5 text-[12px] leading-relaxed text-base-content/60">{item.note}</p>
                      )}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {block.type === "table" && (
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <Table2 class="h-4 w-4 text-accent" />
              <h3 class="text-[17px] font-semibold tracking-tight text-base-content/90">{block.title ?? "Referencia"}</h3>
            </div>
            <div class="overflow-x-auto rounded-2xl bg-base-200 p-1.5">
              <table class="w-full min-w-[560px] border-collapse text-left">
                <thead>
                  <tr class="bg-base-100/70">
                    {block.columns.map((column) => (
                      <th class="whitespace-nowrap px-4 py-3.5 font-mono text-[11px] font-semibold tracking-wide text-base-content/60">{column}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {block.rows.map((row) => (
                    <tr class="border-t border-base-100/50 transition hover:bg-base-100/40">
                      {row.map((cell, cellIndex) => (
                        <td
                          class:list={[
                            "px-4 py-3.5 align-top text-[14px] leading-relaxed",
                            cellIndex === 0
                              ? "font-mono font-medium text-base-content/90"
                              : "text-base-content/70",
                          ]}
                        >
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {block.type === "phrases" && (
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <Terminal class="h-4 w-4 text-accent" />
              <h3 class="text-[17px] font-semibold tracking-tight text-base-content/90">{block.title ?? "Frases útiles"}</h3>
            </div>
            <div class="space-y-2">
              {block.items.map((item) => (
                <div class="flex flex-col gap-3 rounded-2xl bg-base-200 p-4 transition hover:bg-base-300/50 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0 flex-1 space-y-2">
                    <div class="inline-flex max-w-full items-start rounded-xl bg-base-100/80 px-3.5 py-2.5 ring-1 ring-accent/10">
                      <p class="font-mono text-[15px] font-medium leading-relaxed text-base-content">
                        {item.en}
                      </p>
                    </div>
                    <p class="text-[13px] leading-relaxed text-base-content/70">
                      <span class="font-medium text-base-content/45">Significado: </span>{item.es}
                    </p>
                  </div>
                  <div class="flex shrink-0 items-center gap-1">
                    <SavePhraseButton client:load en={item.en} es={item.es} source="Frases" />
                    <SpeakButton text={item.en} />
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {block.type === "tenses" && (
          <div class="grid gap-3 md:grid-cols-2">
            {block.items.map((tense) => (
              <div class="rounded-2xl bg-base-200 p-5">
                <div class="flex flex-wrap items-start justify-between gap-2">
                  <div>
                    <h3 class="text-sm font-medium">{tense.name}</h3>
                    <p class="mt-1 text-[12px] text-base-content/55">{tense.tag}</p>
                  </div>
                  <span class="rounded-full bg-base-100/60 px-2.5 py-1 font-mono text-[10px] font-medium text-base-content/55">
                    {tense.formula}
                  </span>
                </div>
                <ul class="mt-4 space-y-2">
                  {tense.cases.map((example) => (
                    <li class="flex items-start gap-2 text-[13px] leading-relaxed text-base-content/70">
                      <span class="mt-[7px] h-1 w-1 shrink-0 rounded-full bg-accent/60" />
                      <span>{example}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}

        {block.type === "slang" && (
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              <Languages class="h-4 w-4 text-accent" />
              <h3 class="text-[15px] font-medium tracking-tight">{block.title ?? "Slang"}</h3>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              {block.ids.map((id) => {
                const entry = getSlang(id);
                if (!entry) return null;
                return (
                  <div class="rounded-2xl bg-base-200 p-4">
                    <div class="flex items-start justify-between gap-2">
                      <div class="flex min-w-0 flex-wrap items-center gap-1.5">
                        <span class="inline-flex max-w-full items-center rounded-lg bg-accent/[0.08] px-2.5 py-1 ring-1 ring-accent/15">
                          <p class="font-mono text-sm font-medium text-base-content">{entry.term}</p>
                        </span>
                        <span
                          class:list={[
                            "rounded-full px-2 py-0.5 text-[8px] font-medium tracking-wide",
                            entry.status === "2026"
                              ? "bg-accent/10 text-accent"
                              : "bg-base-100/60 text-base-content/40",
                          ]}
                        >
                          {entry.status}
                        </span>
                      </div>
                      <div class="flex shrink-0 items-center gap-1">
                        <SavePhraseButton client:load en={entry.term} es={entry.meaningEs} source="Slang (lección)" />
                        <SpeakButton text={entry.term} />
                      </div>
                    </div>
                    <p class="mt-2.5 text-[13px] leading-relaxed text-base-content/70">
                      <span class="font-medium text-base-content/45">Significado: </span>{entry.meaningEs}
                    </p>
                    <div class="mt-2.5 flex items-start justify-between gap-2 rounded-xl bg-base-100/60 px-3 py-2.5 ring-1 ring-base-content/[0.04]">
                      <p class="font-mono text-[13px] leading-relaxed text-base-content/85">
                        “{entry.example}”
                      </p>
                      <SpeakButton text={entry.example} />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {block.type === "callout" && (
          <div
            class:list={[
              "flex gap-3.5 rounded-2xl p-4 sm:p-4.5",
              block.tone === "warning" && "bg-warning/[0.08]",
              block.tone === "tip" && "bg-accent/[0.06]",
              block.tone === "info" && "bg-info/[0.07]",
            ]}
          >
            <span
              class:list={[
                "mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg",
                block.tone === "warning"
                  ? "bg-warning/12 text-warning"
                  : block.tone === "info"
                    ? "bg-info/12 text-info"
                    : "bg-accent/12 text-accent",
              ]}
            >
              {block.tone === "warning" && <TriangleAlert class="h-4 w-4" />}
              {block.tone === "tip" && <CircleCheckBig class="h-4 w-4" />}
              {block.tone === "info" && <Info class="h-4 w-4" />}
            </span>
            <div class="space-y-1.5">
              <p class="text-[14px] font-semibold text-base-content/90">{block.title}</p>
              <p class="text-[14px] leading-relaxed text-base-content/75">{block.body}</p>
            </div>
          </div>
        )}
      </section>
    ))
  }
</div>
