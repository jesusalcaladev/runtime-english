---
interface Props {
  size?: number
  class?: string
}

const { size = 32, class: className } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M12 10L7.5 16L12 22"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d="M20 10L24.5 16L20 22"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <circle cx="16" cy="16" r="1.6" fill="#10A37F" />
</svg>
