---
interface Props {
  value: number;
  label?: string;
  class?: string;
  tone?: "primary" | "muted";
}

const { value, label, class: className, tone = "primary" } = Astro.props;
const safeValue = Math.max(0, Math.min(100, Math.round(value)));
---

<div
  class:list={["h-1 w-full overflow-hidden rounded-full bg-base-content/[0.07]", className]}
  role="progressbar"
  aria-valuenow={safeValue}
  aria-valuemin={0}
  aria-valuemax={100}
  aria-label={label ?? "Progreso"}
>
  <div
    class:list={[
      "h-full rounded-full transition-[width] duration-500 ease-out",
      tone === "primary" ? "bg-accent" : "bg-base-content/25",
    ]}
    style={`width: ${safeValue}%`}
  ></div>
</div>
