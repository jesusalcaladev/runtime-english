---
import { Ellipsis, PanelLeft, Search, User } from '@lucide/astro'
import { route } from '../../lib/routes'
import ProgressPill from '../dashboard/ProgressPill'
import Logo from '../ui/Logo.astro'
import ChangelogDot from './ChangelogDot'
import InstallAppButton from './InstallAppButton'
import ThemeToggle from './ThemeToggle'

interface Props {
  a1SessionIds: string[]
  b1SessionIds: string[]
  totalSessions: number
  totalExercises: number
}

const { a1SessionIds, b1SessionIds, totalSessions, totalExercises } = Astro.props
const iconButtonClass =
  'surface-soft flex h-9 w-9 items-center justify-center rounded-full text-base-content/60 transition hover:bg-base-300 hover:text-base-content'
---

<header class="sticky top-0 z-50 border-b border-base-content/[0.04] bg-base-100/85 backdrop-blur-xl pt-[env(safe-area-inset-top,0px)] print:hidden">
  <div class="mx-auto flex h-14 w-full max-w-[1600px] items-center justify-between gap-2 px-2.5 sm:gap-3 sm:px-5">
    <div class="flex min-w-0 items-center gap-1.5 sm:gap-2.5">
      <button
        id="mobile-menu-btn"
        type="button"
        class="surface-soft flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-base-content/65 transition hover:bg-base-200 hover:text-base-content lg:hidden"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="app-sidebar"
        onclick="window.dispatchEvent(new CustomEvent('runtimeenglish:menu'))"
      >
        <PanelLeft class="h-4 w-4" />
      </button>

      <a href={route("/")} class="group flex min-w-0 select-none items-center gap-2 sm:gap-2.5" aria-label="RuntimeEnglish — inicio">
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] bg-base-content text-base-100 transition group-hover:opacity-80">
          <Logo size={20} />
        </span>
        <span class="font-pixel-square truncate text-[15px] leading-none sm:text-[17px]">RuntimeEnglish</span>
      </a>
    </div>

    <div class="flex shrink-0 items-center gap-0.5 sm:gap-1.5">
      <div class="hidden sm:block">
        <ProgressPill
          client:only="preact"
          a1SessionIds={a1SessionIds}
          b1SessionIds={b1SessionIds}
          totalSessions={totalSessions}
          totalExercises={totalExercises}
        />
      </div>

      <a href={route("/search")} class={iconButtonClass} aria-label="Buscar" title="Buscar">
        <Search class="h-4 w-4" />
      </a>
      <ThemeToggle client:only="preact" />

      <span class="relative flex shrink-0">
        <a href={route("/settings")} class={iconButtonClass} aria-label="Ajustes de perfil" title="Ajustes">
          <User class="h-4 w-4" />
        </a>
        <ChangelogDot client:only="preact" />
      </span>

      <div class="relative sm:hidden">
        <button
          id="topbar-more-btn"
          type="button"
          class={iconButtonClass}
          aria-label="Más acciones"
          aria-expanded="false"
          aria-controls="topbar-more-menu"
        >
          <Ellipsis class="h-4 w-4" />
        </button>

        <div
          id="topbar-more-menu"
          class="absolute right-0 top-11 z-50 hidden w-56 flex-col gap-1 rounded-2xl border border-base-content/10 bg-base-100 p-2 shadow-xl"
        >
          <InstallAppButton client:only="preact" />
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const topbarWindow = window as Window & { __runtimeenglishTopbarMoreBound?: boolean }
  if (!topbarWindow.__runtimeenglishTopbarMoreBound) {
    topbarWindow.__runtimeenglishTopbarMoreBound = true

    const closeMenu = () => {
      document.getElementById('topbar-more-menu')?.classList.add('hidden')
      document.getElementById('topbar-more-btn')?.setAttribute('aria-expanded', 'false')
    }

    // Delegated so it keeps working after Astro ClientRouter page swaps.
    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return
      const menu = document.getElementById('topbar-more-menu')
      if (!menu) return

      if (target.closest('#topbar-more-btn')) {
        const button = document.getElementById('topbar-more-btn')
        const willOpen = menu.classList.contains('hidden')
        menu.classList.toggle('hidden', !willOpen)
        button?.setAttribute('aria-expanded', String(willOpen))
        return
      }

      if (!menu.contains(target)) closeMenu()
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu()
    })
  }
</script>
